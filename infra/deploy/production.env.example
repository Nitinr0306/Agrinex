# AgriNex - PRODUCTION environment template (ADR-0020 item 4, ADR-0021, ADR-0055). Names and fixed non-secret values
# only; it never holds a secret value.
#
# The production file is /opt/agrinex/.env on the server, mode 600, owned by the deploying user. It is created ONCE
# on the server by infra/deploy/create_server_env.sh, which fills the blanks below without displaying them:
#   - generated on the server, never on a developer machine:   POSTGRES_PASSWORD, REDIS_PASSWORD, JWT_SECRET;
#   - taken from the owner's prod.env (uploaded for that step, then deleted): DATA_GOV_API_KEY, RESEND_API_KEY,
#     AGRINEX_EMAIL_FROM.
# Local values (infra/.env) are never copied here. Set by docker-compose.yml, not here: SPRING_PROFILES_ACTIVE=prod,
# AGRINEX_PUBLIC_ORIGIN=https://${AGRINEX_DOMAIN}, AGRINEX_EMAIL_PROVIDER=resend, and the service host names and ports.

# --- Public address (ADR-0055) ----------------------------------------------------------------------------------
# The only place the public host name is configured: Nginx server name and certificate, CORS, the Origin check and
# every emailed link (https:// followed by this name).
AGRINEX_DOMAIN=agrinex.managio.me

# --- PostgreSQL (spec section 45) --------------------------------------------------------------------------------
POSTGRES_DB=agrinex
POSTGRES_USER=agrinex
# Secret, generated on the server.
POSTGRES_PASSWORD=

# --- Redis (ADR-0018) --------------------------------------------------------------------------------------------
# Secret, generated on the server.
REDIS_PASSWORD=
REDIS_MAXMEMORY=128mb

# --- Authentication (ADR-0016) -------------------------------------------------------------------------------------
# Secret, generated on the server: 256 random bits, base64.
JWT_SECRET=

# --- First ADMIN account (ADR-0028) --------------------------------------------------------------------------------
# Empty: the production data already holds the ADMIN account (ADR-0055 item 3). Fill both only to create the first
# ADMIN of an empty database, and remove the password again after that first start.
AGRINEX_BOOTSTRAP_ADMIN_EMAIL=
AGRINEX_BOOTSTRAP_ADMIN_PASSWORD=

# --- Government data (ADR-0005) -------------------------------------------------------------------------------------
# Secret, from the owner's prod.env: the ROTATED data.gov.in key, never the key exposed before deployment.
DATA_GOV_API_KEY=

# --- Account email through Resend (ADR-0048) ------------------------------------------------------------------------
# Secret, from the owner's prod.env: a production key with sending access to the verified domain only.
RESEND_API_KEY=
# From the owner's prod.env: the sender on the Resend-verified domain managio.me, as "address" or "Name <address>".
AGRINEX_EMAIL_FROM=
