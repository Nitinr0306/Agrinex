# AgriNex - environment contract (spec section 41 and 45; ADR-0021 item 3).
# Owner: DevOps. Changes are reviewed by the Team Lead (spec section 41).
#
# This file lists variable NAMES and non-secret defaults only. It never holds a secret value.
# It is the template for LOCAL development. On this project's laptop the local file is infra/.env
# (docs/LOCAL_DEVELOPMENT_GUIDE.md); elsewhere, create it from this template and fill the blanks there:
#     cp -n infra/.env.example infra/.env      (-n: never replaces an existing infra/.env and its values)
# The public deployment does NOT use this template: its file is /opt/agrinex/.env on the server, created from
# infra/deploy/production.env.example by infra/deploy/create_server_env.sh (docs/operations/DEPLOYMENT_GUIDE.md).
# Local credentials are never copied to the server.
# Never commit .env (spec section 47 Q21; CLAUDE.md section K). On a server, .env is readable only by
# the deploying user (mode 600; ADR-0020 item 4).
#
# Local backing services (PostgreSQL, Redis):
#     docker compose --env-file infra/.env -f infra/docker-compose.yml up -d
# The backend reads the same variables from its process environment.

# --- PostgreSQL (spec section 45: database user agrinex) -------------------------------------------
POSTGRES_DB=agrinex
POSTGRES_USER=agrinex
# Secret. Required.
POSTGRES_PASSWORD=
# Where the backend reaches PostgreSQL. localhost for IDE-based development.
POSTGRES_HOST=localhost
# Host port published by infra/docker-compose.yml and used by the backend. If another PostgreSQL
# already listens on 5432 on this machine, choose a free port here (for example 5433).
POSTGRES_PORT=5432

# --- Redis (ADR-0018: rate-limit counters and reference-data cache only; no persistence) -----------
# Secret. Required.
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAXMEMORY=128mb

# --- Authentication (spec section 28; ADR-0016) ---------------------------------------------------------
# Secret. Required. HS256 signing key for access tokens: at least 256 random bits, base64-encoded,
# for example the output of:  openssl rand -base64 32
JWT_SECRET=

# The one public origin of the deployment (ADR-0017), for example https://agrinex.example.
# Used for the CORS allow-list, the Origin check on refresh and logout, and to build the
# email-verification and password-reset links (never the request Host header; ADR-0048).
# For local development with the frontend dev server: http://localhost:3000
AGRINEX_PUBLIC_ORIGIN=http://localhost:3000

# Host name of the public deployment (ADR-0055). Only the production file sets it (infra/deploy/production.env.example);
# for the local full-stack run of infra/docker-compose.dev.yml it is given on the command line as localhost.
AGRINEX_DOMAIN=

# First ADMIN account (ADR-0028 item 2). Used only at backend start when no ADMIN exists, then the
# password MUST be removed from the environment. Password rule: 15 to 64 characters, at most 72 bytes
# in UTF-8 (ADR-0016). The email is recorded as verified (ADR-0048 item 4).
AGRINEX_BOOTSTRAP_ADMIN_EMAIL=
# Secret, one-time.
AGRINEX_BOOTSTRAP_ADMIN_PASSWORD=

# --- Government data (spec section 31 RULE 1; ADR-0005, ADR-0011) -----------------------------------
# Secret. data.gov.in API key; only the backend ingestion module uses it. Empty = NOT CONFIGURED:
# ingestion runs then fail with an authentication error and stored data keeps being served.
DATA_GOV_API_KEY=

# --- Account email (ADR-0048) ----------------------------------------------------------------------
# none   = non-delivering adapter (local development and tests): nothing is sent, nothing is logged
#          beyond the message kind.
# resend = Resend HTTPS API. Requires RESEND_API_KEY and AGRINEX_EMAIL_FROM on a sending domain
#          verified in Resend (DKIM, SPF). A live send must succeed before relying on it (gate AR-07).
AGRINEX_EMAIL_PROVIDER=none
# Secret.
RESEND_API_KEY=
# Sender address on the verified sending domain of the project domain (RD-037).
AGRINEX_EMAIL_FROM=

# --- Optional ML track (spec section 35; ADR-0030) ----------------------------------------------------
# Used only by the forecasting job in ml/forecasting, and only once the HARD RULE 2 gate and the spec
# section 35 criteria are met. The role agrinex_ml is created by migration V9 without login; the operator
# enables login with this password when the track starts.
ML_DB_USER=agrinex_ml
# Secret.
ML_DB_PASSWORD=
# --- Optional deployment settings ---------------------------------------------------------------------
# The Spring profile: always "local" for development (the "local" document of backend/src/main/resources/
# application.yml: localhost defaults and the dev-server CORS origin, ADR-0017 item 2). "dev" is its former name and still selects it. The
# backend refuses to start without exactly one of local or prod (StartupProfileValidator). The public deployment's
# profile "prod" is pinned in the root docker-compose.yml and never comes from an environment file.
SPRING_PROFILES_ACTIVE=local
# The trusted proxy address (ADR-0017 item 5) is set by the root docker-compose.yml
# (SERVER_TOMCAT_REMOTEIP_INTERNALPROXIES, Spring Boot's environment form of server.tomcat.remoteip.internal-proxies).
