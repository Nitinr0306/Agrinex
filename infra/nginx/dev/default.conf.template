# AgriNex edge for the LOCAL full-stack run only (infra/docker-compose.dev.yml): the same routing as the public
# edge (ADR-0017 item 1) over plain HTTP on localhost, without TLS or certificates. Never used on a deployment.

server_tokens off;

# Referrer-Policy (ADR-0017 item 7): the edge's default applies only when the upstream response sets none. Pages that
# set a stricter policy themselves (the emailed-link pages /verify-email and /reset-password send no-referrer;
# frontend/next.config.ts, ADR-0048 item 2) keep it, and the browser never receives two conflicting values. An empty
# value makes add_header send nothing.
map $upstream_http_referrer_policy $agrinex_referrer_policy {
    ""      "strict-origin-when-cross-origin";
    default "";
}

server {
    listen 80 default_server;
    server_name localhost;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy $agrinex_referrer_policy always;

    location = /actuator {
        return 404;
    }
    location /actuator/ {
        return 404;
    }

    location /api/v1/ {
        proxy_pass http://agrinex-backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
    }

    location / {
        proxy_pass http://agrinex-frontend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
