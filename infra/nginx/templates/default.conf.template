# AgriNex public edge (ADR-0017, ADR-0021, ADR-0055). The official nginx image renders this template at start
# (envsubst, restricted to AGRINEX_* variables by NGINX_ENVSUBST_FILTER) into /etc/nginx/conf.d/default.conf,
# replacing the image's default site. Certificates come from certbot on the host, mounted read-only.
#
# Routing (ADR-0017 item 1): /api/v1/ -> backend; /actuator/ -> 404; every other path, /api/health included ->
# frontend. Plain HTTP redirects to HTTPS except the ACME challenge path (ADR-0021 item 4).
# Headers (ADR-0017 item 7): the frontend sets the per-request Content-Security-Policy of every page
# (frontend/proxy.ts), so this edge adds no second CSP to pages.

server_tokens off;

# Referrer-Policy (ADR-0017 item 7): the edge's default applies only when the upstream response sets none. Pages that
# set a stricter policy themselves (the emailed-link pages /verify-email and /reset-password send no-referrer;
# frontend/next.config.ts, ADR-0048 item 2) keep it, and the browser never receives two conflicting values. An empty
# value makes add_header send nothing.
map $upstream_http_referrer_policy $agrinex_referrer_policy {
    ""      "strict-origin-when-cross-origin";
    default "";
}

upstream agrinex_backend {
    server agrinex-backend:8080;
    keepalive 16;
}

upstream agrinex_frontend {
    server agrinex-frontend:3000;
    keepalive 16;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${AGRINEX_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${AGRINEX_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${AGRINEX_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${AGRINEX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AGRINEX_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:AgrinexTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # No request body in the API is larger than a few kilobytes.
    client_max_body_size 64k;

    # HSTS starts at one day (owner decision, 2026-10-18 pre-deployment review R6). After a week of stable HTTPS,
    # raise it to one year (31536000) in this file and recreate the Nginx container, which renders this template
    # only when it starts; see DEPLOYMENT_GUIDE.md section 8.
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy $agrinex_referrer_policy always;

    # Health is checked only inside the Docker network (ADR-0017 item 1).
    location = /actuator {
        return 404;
    }
    location /actuator/ {
        return 404;
    }

    location /api/v1/ {
        proxy_pass http://agrinex_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # The client address as this edge saw it; the backend trusts only this proxy (ADR-0017 item 5).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        # The edge sets these once for every response.
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
    }

    location / {
        proxy_pass http://agrinex_frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
